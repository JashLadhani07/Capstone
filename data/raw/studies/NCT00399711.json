    "descriptionModule": {
      "briefSummary": "This trial is conducted in the United States of America (USA). This trial compares the changes in HbA1c after 26 weeks of repaglinide and metformin fixed dose combination tablet given as twice daily versus three times daily regimens or versus twice daily rosiglitazone and metformin fixed dose combination tablet in subjects with type 2 diabetes currently on monotherapy."
    },
    "conditionsModule": {
      "conditions": [
        "Diabetes",
        "Diabetes Mellitus, Type 2"
      ]
    },
