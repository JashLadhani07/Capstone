    "baselineCharacteristicsModule": {
      "populationDescription": "144 subjects signed ICF. 4 out of 144 failed in/exclusion criteria 123 subjets are part of the AVS (all valid subjects) population. All 123 UFH treated study subjects had previous and concomitant medications and treatments.",
      "groups": [
        {
          "id": "BG000",
          "title": "Plasma Samples From Subjects Receiving Unfractionated Heparin",
          "description": "A total of 123 valid patients were recruited over three clinical centers (two in Europe, one in the US). The patients were selected from subjects receiving UFH therapy and who have given written informed consent. Excluded from the study were subjects treated with any other anticoagulants other than UFH, subjects who have been undergoing fibrinolytic therapy within the previous 4 weeks, subjects known to have a congenital bleeding disorder, subjects known to show coagulation factor deficiencies and subjects known to have a coagulation inhibitor or an unexplained APTT prolongation."
        }
      ],
