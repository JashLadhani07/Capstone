    "outcomesModule": {
      "primaryOutcomes": [
        {
          "measure": "Overall Sensitivity and Specificity of Pefakit and Hemosil.",
          "description": "Sensitivity is the proportion of positive cases identified as positive. Specificity is the proportion of negative cases identified as negative. The Sensitivity and Specificity of Pefakit and Hemosil were calculated for the overall study population and separately for each of the three medical centers. Sensitivity and Specificity of Pefakit and Hemosil were each assessed relative to the reference method (Biophen)",
          "timeFrame": "within 2 - 4 days"
        }
      ]
    },
    "eligibilityModule": {
      "eligibilityCriteria": "Inclusion Criteria:\n\n* Subjects receiving a continuous infusion with UFH\n* Subjects who have given written informed consent (unless written informed consent is waived by local regulations or local EC/IRB)\n\nExclusion Criteria:\n\n* Subjects treated with any other anticoagulants other than UFH\n* Subjects who have been undergoing fibrinolytic therapy within the previous 4 weeks\n* Subjects who are known to have a congenital bleeding disorder\n* Subjects known to present unexplained prolongations of clotting time\n* Subjects known to have coagulation factor deficiencies\n* Patient participating or who has participated within one month from enrolment in another investigational study",
      "healthyVolunteers": false,
      "sex": "ALL",
      "stdAges": [
        "CHILD",
        "ADULT",
        "OLDER_ADULT"
      ],
      "studyPopulation": "Subjects undergoing UFH anticoagulation therapy will are needed for this study. Typically, such patients are undergoing cardiovascular surgery, are being treated for thromboembolic events, or are receiving heparin intravenously for thrombosis prophylaxis due to its more advantageous pharmacokinetic profile in some situations.",
      "samplingMethod": "NON_PROBABILITY_SAMPLE"
    },
